{
  "name": "fcm-push-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js --production",
    "preview": "pnpm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm test && pnpm build",
    "auth:token": "node server/print-token.js"
  },
  "dependencies": {
    "google-auth-library": "^11.3.4",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
